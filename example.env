# DemandIQ Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-demandiq-local-development-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to local SQLite for instant zero-config startup, or PostgreSQL)
# For SQLite: leave empty or DB_ENGINE=sqlite
DB_ENGINE=sqlite
# For PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=demandiq
# DB_USER=demandiq_user
# DB_PASSWORD=demandiq_secret
# DB_HOST=localhost
# DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Business Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
